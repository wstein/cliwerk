complete -c 'fishposroot' -e
function __picocli_fishposroot_position
    set -l lo 0
    set -l hi 0
    set -l ended 0
    set -l after_option 0
    set -l first 1
    for word in (commandline -opc)
        if test $first -eq 1
            set first 0 # the name of the command itself
        else if test $ended -eq 1
            set lo (math $lo + 1)
            set hi (math $hi + 1)
        else if test "$word" = "$argv[5]"
            set ended 1
        else if string match -q -r -- '^-.' $word
            set after_option 1
            if string match -q -r -- '^-[0-9]' $word # a negative number is a positional parameter, unless an option has that name
                set hi (math $hi + 1)
            end
        else
            set hi (math $hi + 1)
            if test $argv[4] -eq 0; or test $after_option -eq 0
                set lo (math $lo + 1)
            end
            set after_option 0
        end
    end
    set lo (math $lo - $argv[1])
    set hi (math $hi - $argv[1])
    test $lo -lt 0; and set lo 0
    test $hi -ge $argv[2]; and begin; test $argv[3] -lt 0; or test $lo -le $argv[3]; end; and begin; test "$argv[6]" != exact; or test $lo -eq $hi; end
end
